-- Scene Manager installer. In 3ds Max: Scripting > Run Script... and pick this file.
-- Writes a startup script that adds this folder to Python's path, registers callbacks,
-- starts the Claude bridge, and defines the toolbar macro (category "SceneManager").
(
    local root = substituteString (getFilenamePath (getSourceFileName())) "\\" "/"
    local startupFile = (getDir #userStartupScripts) + "\\scene_manager_startup.ms"
    local f = createFile startupFile
    format "-- Scene Manager startup (generated by install_scene_manager.ms)\n" to:f
    format "python.execute \"import sys\\nroot = r'%'\\nif root not in sys.path: sys.path.insert(0, root)\\nimport scene_manager.startup\\nscene_manager.startup.init()\"\n" root to:f
    format "macroScript SceneManagerOpen category:\"SceneManager\" tooltip:\"Scene Manager\" buttonText:\"Scene Mgr\"\n(\n    python.execute \"import scene_manager.ui.main_window as w; w.show()\"\n)\n" to:f
    close f
    fileIn startupFile
    python.execute "import scene_manager.ui.main_window as w; w.show()"
    messageBox ("Scene Manager installed.\n\nStartup file:\n" + startupFile + "\n\nAdd a toolbar button: Customize > Customize User Interface > Toolbars > Category: SceneManager.") title:"Scene Manager"
)
